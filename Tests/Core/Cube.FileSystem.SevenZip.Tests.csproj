<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <StartupObject>Cube.FileSystem.SevenZip.Tests.Program</StartupObject>
        <OutputType>Exe</OutputType>
        <!-- RID は Platform に追従させる。win-x64 固定だと -p:Platform=arm64 のとき
             PlatformTarget=arm64 と衝突して NETSDK1032 でビルドできない。
             AnyCPU は既定の x64 テスト実行を維持するため win-x64 に寄せる。
             arm64 のテスト実行自体は arm64 ホストが必要。 -->
        <RuntimeIdentifier Condition="'$(Platform)' == 'arm64'">win-arm64</RuntimeIdentifier>
        <RuntimeIdentifier Condition="'$(Platform)' != 'arm64'">win-x64</RuntimeIdentifier>
        <SelfContained>false</SelfContained>
        <IsPackable>false</IsPackable>
        <SatelliteResourceLanguages>_</SatelliteResourceLanguages>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\Libraries\Core\Cube.FileSystem.SevenZip.csproj" />
        <ProjectReference Include="..\Private\Cube.Private.Tests.csproj" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
        <PackageReference Include="Appveyor.TestLogger" Version="2.0.0" />
        <!-- NUnit3TestAdapter が要求する依存を明示固定 (transitive だが version 解決が net10.0 で不安定なため明示) -->
        <PackageReference Include="Microsoft.Extensions.DependencyModel" Version="10.0.11" />
    </ItemGroup>
    <ItemGroup>
<None Include="Examples\**\*" CopyToOutputDirectory="Always" />
    </ItemGroup>
</Project>
