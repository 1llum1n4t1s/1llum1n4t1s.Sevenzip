<?xml version="1.0" encoding="utf-8"?>
<!--
    1llum1n4t1s.Sevenzip: コンシューマー向け MSBuild ターゲット定義。
    NuGet パッケージの buildTransitive/ に配置されるため、ライブラリを参照する
    プロジェクトでビルド時に自動的にインポート・実行される。

    2 段階構成:
      [1] _SevenZipCopyEmbedded  : 埋め込み 7z.dll を OutputPath にコピー (常時実行、ネット不要)
      [2] _SevenZipAutoFetch     : GitHub Releases から最新版を取得試行 (opt-out 可)

    設計の肝:
      - Step 1 が必ず先に実行されるため、Step 2 が何らかの理由で失敗しても
        コンシューマーの OutputPath には埋め込み版 7z.dll が残る (fallback 保証)。
      - Step 2 は失敗してもビルドを止めない (IgnoreExitCode + ContinueOnError)。
-->
<Project>

    <!--
        RID の決定ロジック。
        優先順位:
          1. コンシューマー明示指定の $(RuntimeIdentifier)
          2. $(PlatformTarget) が ARM64 の場合 win-arm64
          3. 既定 win-x64
    -->
    <PropertyGroup>
        <_SevenZipRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_SevenZipRid>
        <_SevenZipRid Condition="'$(_SevenZipRid)' == '' and '$(PlatformTarget)' == 'ARM64'">win-arm64</_SevenZipRid>
        <_SevenZipRid Condition="'$(_SevenZipRid)' == ''">win-x64</_SevenZipRid>
        <_SevenZipEmbeddedDll>$(MSBuildThisFileDirectory)..\runtimes\$(_SevenZipRid)\native\7z.dll</_SevenZipEmbeddedDll>
    </PropertyGroup>

    <!-- Step 1: 埋め込み 7z.dll を OutputPath に配置 (ネット非依存のフォールバック基盤) -->
    <Target Name="_SevenZipCopyEmbedded"
            BeforeTargets="Build"
            Condition="Exists('$(_SevenZipEmbeddedDll)')">
        <Copy SourceFiles="$(_SevenZipEmbeddedDll)"
              DestinationFiles="$(OutputPath)7z.dll"
              SkipUnchangedFiles="true" />
    </Target>

    <!--
        Step 2: GitHub Releases から最新版を取得試行。
        - Fetch-SevenZip.ps1 が全ロジックを担う (GitHub API / Authenticode 検証 / キャッシュ管理)。
        - 失敗は silent: OutputPath の埋め込み版 7z.dll がそのまま有効な状態で残る。
        - ネット非対応環境・CI では <SevenZipAutoUpdate>false</SevenZipAutoUpdate> で停止可能。
        - Exists ガード: 埋め込み版が存在しない = パッケージ不整合 = fetch しても PS1 の
          bootstrap (Add-Type Cube.FileSystem.SevenZip.dll) が成功しないため pwsh 起動自体を省く。
    -->
    <Target Name="_SevenZipAutoFetch"
            AfterTargets="_SevenZipCopyEmbedded"
            Condition="'$(SevenZipAutoUpdate)' != 'false' and '$(OS)' == 'Windows_NT' and Exists('$(_SevenZipEmbeddedDll)')">
        <Exec Command="pwsh -NonInteractive -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)Fetch-SevenZip.ps1&quot; -Rid &quot;$(_SevenZipRid)&quot; -OutputDir &quot;$(OutputPath)&quot;"
              IgnoreExitCode="true"
              ContinueOnError="true"
              StandardOutputImportance="Low"
              StandardErrorImportance="Low" />
    </Target>

</Project>
