<?xml version="1.0" encoding="utf-8"?>
<!--
    1llum1n4t1s.Sevenzip: コンシューマー向けプロパティ定義。
    NuGet パッケージに同梱され、ライブラリを参照するプロジェクトのビルド開始時に
    自動的にインポートされる (buildTransitive/ 配下に配置)。

    既定値:
    - SevenZipAutoUpdate = true
        ビルド時に GitHub Releases から最新の 7-Zip native バイナリを取得する。
        false に設定するとネットワークアクセスなしで同梱版 7z.dll のみを使う。
-->
<Project>
    <PropertyGroup>
        <SevenZipAutoUpdate Condition="'$(SevenZipAutoUpdate)' == ''">true</SevenZipAutoUpdate>
    </PropertyGroup>
</Project>
